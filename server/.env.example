# NutriTrack Server Environment Configuration

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Database — MongoDB (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/nutritrack
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/nutritrack_test

# JWT Access Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long_here
JWT_ISSUER=nutritrack-auth
JWT_AUDIENCE=nutritrack-client
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh Token & Session Security
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_min_32_chars_long_here
REFRESH_TOKEN_EXPIRES_DAYS=7

# Email Transport (SMTP / Resend / SendGrid / Mailgun)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="NutriTrack Health" <no-reply@nutritrack.io>

# External Verified Food Data Provider (Optional — USDA FoodData Central)
# Reference: https://fdc.nal.usda.gov/api-guide/
FOOD_DATA_PROVIDER=usda
FOOD_DATA_API_KEY=

# File Storage Configuration (Optional — S3 / Cloudinary / Local Secure Storage)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Logging Level
LOG_LEVEL=info
